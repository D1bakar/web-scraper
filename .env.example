# Application
APP_NAME=Web Scraper Pro
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/scraper.db

# Scraping defaults
DEFAULT_DELAY=1.0
DEFAULT_TIMEOUT=15
DEFAULT_RETRIES=3
DEFAULT_USER_AGENT=Mozilla/5.0 (compatible; WebScraperPro/2.4.0; +https://github.com/D1bakar/web-scraper)
MAX_CONCURRENT_JOBS=5
RATE_LIMIT_PER_MINUTE=120
CHECK_ROBOTS_TXT=true
ALLOW_PRIVATE_URLS=false

# Optional admin login (mobile-friendly session auth)
# ADMIN_USER=admin
# ADMIN_PASSWORD=your-secure-password
# SESSION_SECRET=random-32-char-string

# Security (optional — uncomment for production)
# API_KEY=your-secret-api-key-here
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# MAX_REQUEST_BODY_BYTES=1048576

# Optional webhook notification on job complete/fail
# WEBHOOK_URL=https://your-server.com/webhook

# Logging
LOG_LEVEL=INFO
