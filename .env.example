# Application
APP_NAME=Web Scraper Pro
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/scraper.db

# Scraping defaults
DEFAULT_DELAY=1.0
DEFAULT_TIMEOUT=15
DEFAULT_RETRIES=3
DEFAULT_USER_AGENT=Mozilla/5.0 (compatible; WebScraperPro/2.0; +https://github.com/D1bakar/web-scraper)
MAX_CONCURRENT_JOBS=5
RATE_LIMIT_PER_MINUTE=60
CHECK_ROBOTS_TXT=true

# Logging
LOG_LEVEL=INFO
